SWAP_SLEEP_INTERVAL=30
SWAP_EMERGENCY_INTERVAL=10
SWAP_THRESHOLD_HIGH=85
SWAP_THRESHOLD_LOW=40
SWAP_SIZE=4096
MAX_SWAP_FILES=4
SWAP_CREATE_RATE_LIMIT=300
SWAP_DELETE_RATE_LIMIT=600
WORKER_POOL_SIZE=1
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500
RETRY_MAX_DELAY_MS=5000

# PHASE 2: PSI MONITORING
PSI_ENABLED=true
PSI_HIGH_THRESHOLD=80.0
PSI_LOW_THRESHOLD=40.0

# PHASE 2: PROMETHEUS METRICS
METRICS_ENABLED=true
METRICS_PORT=9100

# PHASE 2: AUTO-PROFILE SELECTION
AUTO_PROFILE=true
# Profiles: laptop, workstation, server
FORCE_PROFILE=

# v2.1 HYBRID ADAPTIVE - THRESHOLDS (Configurable)
# Trigger swap creation when SwapPercent >= this
SWAP_ALERT_THRESHOLD=85
# Delete swap only when SwapPercent <= this
SWAP_DELETE_THRESHOLD=30
# Require SwapPercent >= this before creating more swaps
SWAP_USE_THRESHOLD=60

# v2.1 PEAK DETECTION - Memory Delta (rapid increase)
# Detect peak if RAM increased by > this % in window
MEM_DELTA_THRESHOLD=10.0
# Window in seconds to measure memory delta
MEM_DELTA_WINDOW_SEC=60

# v2.1 FAST FILLING DETECTION - Swap Delta (rapid filling)
# Detect fast filling if swap increased by > this % in window
SWAP_DELTA_THRESHOLD=20
# Window in seconds to measure swap delta
SWAP_DELTA_WINDOW_SEC=45

# v2.1 RATE LIMITS - Response times (in seconds)
# How fast to respond to peaks (immediate action)
PEAK_RESPONSE_SEC=10
# How conservative for gradual changes
GRADUAL_RESPONSE_SEC=300

# v2.1 HYSTERESIS - Waiting periods (in seconds)
# Wait between create and delete actions
CREATE_DELETE_HYSTERESIS_SEC=30
# Wait after delete before allowing new creates
DELETE_WAIT_SEC=120
